  "description": "India-ready weather-to-agricultural intelligence platform delivering verified panchayat-level farm advisories",
  "start_url": "/app/farmer",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#F6F9F5",
  "theme_color": "#126B3A",
  "orientation": "portrait-primary",
  "categories": ["weather", "agriculture", "productivity", "utilities"],
  "lang": "hi-IN",
  "icons": [
    {
      "src": "/icon-192.png",
