
# Weather source selection
# Open-Meteo is the default public fallback: no key is needed for eligible
# low-volume/non-commercial use. Display attribution wherever its data appears.
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_API_KEY=

# IMD API Settings. Obtain a documented endpoint contract and credentials from
# IMD before setting these; the application must never simulate IMD responses.
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in/api/v1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Delivery is disabled until a provider is configured. MSG91 is the India-first
# recommended option (SMS, WhatsApp templates, voice/IVR); a trial still needs
# a registered account, approved sender/templates, and webhook verification.
# Never expose these values to Vite.
DELIVERY_PROVIDER=
DELIVERY_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# Absolute path to a versioned, validated ML evaluation artifact. An empty value
# keeps the spatial model in NOT_PRODUCTION_READY state.
MODEL_EVALUATION_PATH=
